__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# Phase 0 Renode/Zephyr spike scratch space (findings live in docs/renode-spike.md).
spike/

# Local editor and OS files.
.vscode/
.idea/
.DS_Store
Thumbs.db

# Runtime outputs are generated by local compile/simulation runs and must not
# be tracked (tests/test_repo_hygiene.py enforces this).
cases/*/artifacts/build/
cases/*/artifacts/logic/*.vcd
cases/*/artifacts/serial/*.log
cases/*/artifacts/archive/
cases/*/artifacts/submissions/
cases/*/artifacts/verification.json
cases/*/case.resc
cases/*/sketch/*/build/
cases/*/sketch/*/sdkconfig
cases/*/sketch/*/sdkconfig.old
cases/*/sketch/*/sdkconfig.*
cases/*/*.vcd

# Variant outputs are generated, except diagram.json: variant diagrams are
# deterministic derived inputs that the provenance manifest and
# --use-existing-artifacts validation read, so they stay tracked and reviewed.
cases/*/artifacts/variants/*
!cases/*/artifacts/variants/*/
cases/*/artifacts/variants/*/*
!cases/*/artifacts/variants/*/diagram.json
!cases/*/artifacts/variants/*/case.repl

# Renode CreateFileBackend rotates an existing log to <name>.1 instead of truncating.
cases/*/artifacts/serial/*.serial.log.*

# Local-only agent-context system (private project memory, not shipped docs).
# Root agent guides and the .agent-context notes stay untracked on purpose;
# the shipped overview is README.md, which remains tracked. If a nested
# path-scoped AGENTS.md/CLAUDE.md is ever added, these patterns already cover it.
/AGENTS.md
/CLAUDE.md
.agent-context/
**/AGENTS.md
**/CLAUDE.md
.claude/

# Local Zephyr flake investigation logs (not fixtures).
zephyr-flakes*.jsonl

# Leaderboard orchestration run outputs are scratch. Published bundles, if any,
# belong under a curated results/ tree instead.
/runs/

# Transient live-sweep dump from scripts/renode_live_sweep.ps1. The tracked,
# machine-checkable proof artifact is docs/zephyr_nano33ble-evidence.json
# (built by `bench.cli evidence-index`); this per-run dump is regenerated and
# was going stale in git, so it stays untracked.
zephyr-live-status.json
